{
  "name": "omnia-extensao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OMNIA Apoio — extensão do Chrome para o WhatsApp Web (painel lateral).",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts && tsx scripts/manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "tsx scripts/zip.ts",
    "sync:sanitizar": "tsx scripts/sync-sanitizar.ts",
    "gerar:politica": "tsx scripts/gerar-politica.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.0",
    "@fontsource/cinzel": "^5.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
